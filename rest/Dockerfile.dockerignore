# Ignored in the build context (the clone of rest-framework) of rest/Dockerfile: local builds and installs.
# Only untracked directories: a tracked file missing in the context (e.g. the references of the pipeline
# tests, examples/test/reference/*.root) would make the git tree of the build not clean (codeClean of the run
# files, and the image check of the rest-framework validation fails)
build/
install/
